OPENAI_API_KEY=your_openai_api_key
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your_langsmith_api_key
LANGSMITH_PROJECT="interrupt-workshop"

# Extension A (prompt-injection guard) -- all optional, guard works offline with defaults
GUARD_LAYER_FRAMING=true
GUARD_LAYER_TOOL_VALIDATOR=true
GUARD_LAYER_DETECTOR=true
GUARD_LAYER_MEMORY_PROTECTION=true
GUARD_DETECTOR_USE_LLM=false
GUARD_ALLOWED_RECIPIENT_DOMAINS=company.com